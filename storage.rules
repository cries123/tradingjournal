rules_version = '2';

// Firebase Storage security rules. Paste this into Firebase Console → Storage → Rules — there is
// no firebase.json/storage config in this repo, so this file is a reference to copy in by hand,
// the same way firestore.rules is.
//
// Nothing is stored in Storage any more. The only thing that ever used it was the share card's
// custom backgrounds (shareCardBackgrounds/{uid}/…), and share cards have been removed along with
// the rest of the sharing features. This file stays, closed, rather than being deleted: an
// unmanaged bucket with no rules file to point at is how a permissive default gets left in place
// the next time something needs to upload.
//
// Publishing this also revokes access to any backgrounds still sitting in the bucket. Deleting
// those objects is a separate job in the Firebase console, and worth doing — they are public
// images nobody can reach from the product any more.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
