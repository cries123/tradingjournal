rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }

    function isSiteAdminUser(userId) {
      return exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == userId;
    }

    function adminCanDeleteUser(userId) {
      return isAdmin()
        && request.auth.uid != userId
        && !isSiteAdminUser(userId);
    }

    function validBugReportCreate() {
      return request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && (
          (request.auth != null && request.resource.data.uid == request.auth.uid)
          || (request.auth == null && request.resource.data.uid == null)
        );
    }

    function validBrokerSupportCreate() {
      return request.resource.data.brokerName is string
        && request.resource.data.brokerName.size() >= 2
        && request.resource.data.exportMethod is string
        && request.resource.data.exportMethod.size() >= 3
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && (
          (request.auth != null && request.resource.data.uid == request.auth.uid)
          || (request.auth == null && request.resource.data.uid == null)
        );
    }

    match /config/brokers {
      allow read: if true;
      allow write: if false;
    }

    // The site-wide banner, edited from the admin panel. Public read because every visitor has to
    // render it; admin-only write because it's a message shown to everyone in the product's own
    // voice, and anyone who could write it could put anything there.
    match /config/announcement {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The plan-checkout maintenance switch. Public read so the pricing page can say purchases are
    // paused rather than showing a button that only fails when clicked; admin-only write because
    // it decides whether the site takes money at all.
    //
    // Read access grants nothing here: the switch is enforced server-side by the checkout
    // function, which reads this document with the Admin SDK. A client that lies to itself about
    // the value just gets refused a moment later.
    match /config/checkout {
      allow read: if true;
      allow write: if isAdmin();
    }

    /*
     * Broker availability, flipped from the admin panel instead of by deploying a code change.
     *
     * Public read because every visitor's connect page renders it — and a visitor who cannot read
     * it would be shown a connect button for a broker that is known to be down. Admin-only write
     * because the message is displayed to users in the product's own voice, and 'down' blocks a
     * feature people pay for.
     */
    match /config/brokerStatus {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/admin {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/config/admin)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.claimedAt is string;
      allow update, delete: if false;
    }

    match /bugReports/{reportId} {
      allow create: if validBugReportCreate();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    /*
     * Support tickets, and the conversation inside each one.
     *
     * A ticket belongs to exactly one signed-in user; both they and the admin can read it and
     * append to it, and nobody else can do either. The subcollection is where the chat lives, so
     * its rules are the ones that matter most: a message is immutable once written (no update, no
     * delete, for either side), because a support thread that can be silently edited afterwards is
     * worthless as a record of what was agreed — particularly for the billing disputes this exists
     * to handle.
     *
     * `from` is pinned to who is writing: a user's message can only be a user message, and only
     * the admin can post as support. Without that, anyone could write a reply into their own
     * ticket that renders as coming from us.
     */
    function ticketExists(ticketId) {
      return exists(/databases/$(database)/documents/supportTickets/$(ticketId));
    }

    function ticketData(ticketId) {
      return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
    }

    /* Guarded with exists(): reading .data off a document that isn't there errors, and an errored
       condition denies — which is how the whole feature came to be unusable. */
    function ownsTicket(ticketId) {
      return request.auth != null
        && ticketExists(ticketId)
        && ticketData(ticketId).uid == request.auth.uid;
    }

    function validTicketCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && request.resource.data.messageCount is number;
    }

    match /supportTickets/{ticketId} {
      allow create: if validTicketCreate();

      // `read` covers both get and list. A list query is only permitted when every document it
      // would return passes this rule, so a client asking for the whole collection is denied and
      // one filtered to `where('uid', '==', <their own uid>)` succeeds.
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      // The owner may move the conversation along and close it, and nothing else — not the uid it
      // belongs to, not the email it was opened with, not the admin's private note.
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'lastMessageAt', 'lastMessageFrom', 'lastMessagePreview',
              'messageCount', 'unreadForUser', 'unreadForSupport'
            ])
          && request.resource.data.status in ['open', 'closed']
        );

      allow delete: if false;
    }

    match /supportTickets/{ticketId}/messages/{messageId} {
      allow read: if isAdmin() || ownsTicket(ticketId);

      /*
       * The first message of a ticket is written in the SAME batch as the ticket itself, and rules
       * cannot see uncommitted writes from their own batch — get() reads committed data only. So
       * requiring the parent to exist made the opening message of every ticket impossible, the
       * batch failed atomically, and nobody could open a ticket at all.
       *
       * Ownership is therefore enforced against the parent only once the parent is there. While it
       * is absent, a signed-in user may write a message that names themselves as its author, which
       * is exactly the batch above. Nothing leaks: reading still requires ownsTicket, so an orphan
       * message under a made-up id is unreadable even by whoever wrote it, and the moment a real
       * ticket exists the ownership check applies again — so nobody can append to someone else's
       * thread.
       */
      allow create: if request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.createdAt is string
        && (
          (isAdmin() && request.resource.data.from == 'support')
          || (
            request.auth != null
            && request.resource.data.from == 'user'
            && request.resource.data.authorUid == request.auth.uid
            && (ownsTicket(ticketId) || !ticketExists(ticketId))
          )
        );

      allow update, delete: if false;
    }

    /*
     * Weekly-recap opt-in, one document per user.
     *
     * Top-level rather than a field on the settings document because the scheduled job has to
     * query across everybody, and a collectionGroup query needs a hand-built index.
     *
     * A user may set exactly two things about themselves. lastRecapSentAt is written only by the
     * scheduled function through the Admin SDK, and pinning the writable keys is what stops
     * someone clearing it to make the job send them the same email repeatedly.
     */
    match /emailPrefs/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.recap is bool
        && request.resource.data.keys().hasOnly(['uid', 'recap', 'updatedAt']);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.recap is bool
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['recap', 'updatedAt']);

      allow delete: if adminCanDeleteUser(userId);
    }

    /*
     * The production error feed, one document per distinct bug.
     *
     * Written ONLY by the Admin SDK, from netlify/functions/report-error.ts, which recomputes the
     * fingerprint itself — so a client cannot choose a document id, cannot forge a failure, and
     * cannot inflate a count. Read is admin-only because these documents contain stack traces and
     * the uids of the people who hit them.
     *
     * The single writable field is `status`, which is the admin marking a bug fixed or ignored
     * from the panel.
     */
    match /errorEvents/{fingerprint} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create, delete: if false;
    }

    /*
     * Cached monthly cost totals, written by the admin cost report as it walks the usage counters.
     *
     * Server-only. The numbers are derived from data the client already cannot read (per-user
     * usage), and a client that could write here could make a month look cheap.
     */
    /*
     * Money actually collected, one row per Creem payment event. Written only by the webhook
     * through the Admin SDK — a client that could write here could invent revenue.
     */
    match /billingCharges/{eventId} {
      allow read, write: if false;
    }

    match /adminCostMonths/{month} {
      allow read, write: if false;
    }

    // Daily counter for the error feed's own fuse. Server-only, like every other rate limit here.
    match /errorBudget/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /brokerSupportRequests/{requestId} {
      allow create: if validBrokerSupportCreate();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if adminCanDeleteUser(userId);
      allow get: if request.auth != null && request.auth.uid == userId;
      allow get, list: if isAdmin();
    }

    match /users/{userId}/settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if adminCanDeleteUser(userId);
      allow get, list: if isAdmin();
    }

    match /users/{userId}/trades/{tradeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if adminCanDeleteUser(userId);
      allow get, list: if isAdmin();
    }

    match /users/{userId}/dayNotes/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if adminCanDeleteUser(userId);
    }

    // Cached AI dashboard takeaways, one doc per period. Written only by the Admin SDK from
    // netlify/functions/ai-takeaway.ts — the client never writes here, because a client that could
    // write its own cache entry could also write one for a period it never paid a generation for,
    // and the cache is checked before the daily counter is charged. Read is allowed so a future
    // client can render a cached takeaway without a round trip; the delete rule keeps account
    // deletion complete.
    match /users/{userId}/takeaways/{periodKey} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      allow delete: if adminCanDeleteUser(userId);
    }

    // Broker-connect secrets (SnapTrade userSecret). Written only by the admin SDK from
    // netlify/functions/broker-connect.ts, which bypasses these rules entirely — this block just
    // makes explicit that the client SDK can never read or write it, even by accident.
    match /users/{userId}/private/{docId} {
      allow read, write: if false;
    }

    match /coachShares/{shareToken} {
      /*
       * `get`, NOT `read`.
       *
       * `allow read` grants get AND list, and rules are OR'd — there is no deny — so the
       * `allow list: if isAdmin()` below did not narrow anything. Effective list permission was
       * `true || isAdmin()`, i.e. public: anyone could enumerate the whole collection straight off
       * the Firestore REST endpoint, with no token and no share link, and read every user's
       * trades, P&L and private notes. The project id is in the shipped bundle, so nothing needed
       * guessing. `get` is what this feature actually needs — you follow a link you were given.
       */
      allow get: if true;
      allow list: if isAdmin();

      /*
       * Update must check the EXISTING owner, not just the incoming one.
       *
       * `request.resource.data` is the document after the write, so checking only that field let
       * any signed-in user overwrite any share token with themselves as ownerUid — taking over,
       * defacing, or deleting (by first seizing ownership) somebody else's share. The second
       * clause pins ownership so it can never be transferred by a write.
       */
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid
        || (isAdmin() && adminCanDeleteUser(resource.data.ownerUid));
    }

    // The real, opt-in leaderboard — one doc per opted-in user, written by that user's own
    // client (see src/hooks/useLeaderboardSync.ts), same trust model as coachShares above.
    // Public read so the leaderboard page can query everyone at once; write restricted to the
    // doc's own uid so nobody can write (or read into existence, via a client bug) another
    // user's entry.
    match /leaderboardEntries/{userId} {
      allow read: if true;
      // The anonymity setting has to hold here, not just in the client. These documents are
      // world-readable, so an entry that says isAnonymous while carrying a username is a real name
      // published to anyone who queries the collection — which is exactly what shipped until the
      // app stopped writing it. Enforcing it in the rule means a stale build, a replayed request
      // or a hand-rolled client cannot put it back.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.stats is map
        && (request.resource.data.isAnonymous != true
            || !('username' in request.resource.data));
      allow delete: if request.auth != null && request.auth.uid == userId
        || (isAdmin() && adminCanDeleteUser(userId));
    }

    match /usernames/{usernameId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/usernames/$(usernameId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == usernameId;
      allow delete: if isAdmin()
        && resource.data.uid is string
        && adminCanDeleteUser(resource.data.uid);
      allow update: if false;
    }

    function validVisitorDailyCreate() {
      return request.resource.data.keys().hasAll(['visitorId', 'date', 'path', 'createdAt'])
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.createdAt is string;
    }

    /*
     * The document id is passed IN rather than read from the enclosing match.
     *
     * This function is declared out here, at the documents level, and rules functions close over
     * the scope they are DECLARED in — not the scope they are called from. The previous version
     * referenced a bare `visitorId`, which is the wildcard of `match /analyticsVisitors/{visitorId}`
     * and simply does not exist here. An undefined identifier makes the whole expression error,
     * and an errored condition denies.
     *
     * So every write to a visitor profile — create and update alike — was refused from the day
     * this shipped, and analyticsVisitors never received a single document. The admin funnel read
     * a real zero for "Visitors" and "Opened the journal" while the daily-visit collection beside
     * it filled up normally, because validVisitorDailyCreate touches no path variable and was
     * therefore never affected.
     */
    function validVisitorProfileWrite(docId) {
      return request.resource.data.visitorId is string
        && request.resource.data.visitorId == docId
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastPath is string;
    }

    function validVisitorConversionWrite() {
      return request.resource.data.converted == true
        && request.resource.data.convertedAt is string
        && request.resource.data.signupUid is string;
    }

    match /analyticsDailyVisitors/{docId} {
      allow create: if validVisitorDailyCreate()
        && docId == request.resource.data.date + '_' + request.resource.data.visitorId;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /analyticsVisitors/{visitorId} {
      allow create: if validVisitorProfileWrite(visitorId)
        && request.resource.data.converted == false
        && request.resource.data.firstSeenAt is string;

      // Two legal updates, and nothing else:
      //   1. the per-visit heartbeat, which may touch lastSeenAt/lastPath/openedApp but must
      //      leave `converted` exactly as it was;
      //   2. the one-way flip to converted, which is only allowed from false.
      //
      // The previous version of rule 1 required `converted` to be ABSENT from the incoming
      // data. That can never hold: Firestore evaluates request.resource.data as the document
      // AFTER the merge, so an existing `converted` field is always present in it, and every
      // heartbeat after the very first visit was denied. Comparing the old and new values is
      // the check that was actually intended.
      allow update: if resource.data.visitorId == visitorId
        && (
          (validVisitorProfileWrite(visitorId)
            && request.resource.data.converted == resource.data.converted)
          || (resource.data.converted == false && validVisitorConversionWrite())
        );

      allow read: if isAdmin();
      allow delete: if false;
    }

    // Per-user daily counter for assistant questions, written by the ai-assistant function via
    // the Admin SDK. Denied to clients on purpose: a rate limit the client can edit is not a
    // rate limit.
    match /aiUsage/{docId} {
      allow read, write: if false;
    }

    // Same deal for broker syncs per day. Read it through /api/entitlement, which counts it
    // server-side; a client that could edit this could sync as often as it liked, and every sync
    // costs a paid SnapTrade call.
    match /syncUsage/{docId} {
      allow read, write: if false;
    }

    // What a user has paid for (or been granted). Written ONLY by the Admin SDK — the Creem
    // webhook and the admin panel — because an entitlement the client can write is not an
    // entitlement, it's a suggestion. Users may read their own so the UI knows what to show,
    // and the admin can list them to manage tiers.
    match /entitlements/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // Delivered Creem webhook ids, used to make retries idempotent. Server-only.
    match /creemEvents/{eventId} {
      allow read, write: if false;
    }

    // Written only by the broker-connect serverless function via the Admin SDK (which bypasses
    // these rules). No client ever needs to read or write it, so nothing is granted here.
    match /brokerConnections/{userId} {
      allow read, write: if false;
    }

    match /deletedAccounts/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if adminCanDeleteUser(userId);
      allow update, delete: if false;
    }

    // Internal admin-only notes/flags about a user account — deliberately separate from
    // /users/{userId}, which the user themselves can read and write.
    match /adminUserNotes/{userId} {
      allow read, write: if isAdmin();
    }

    // Immutable trail of admin actions (status/priority/note changes, account edits, deletes).
    // Only ever appended to, never edited or removed, so it stays trustworthy as a record.
    match /adminAuditLog/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Point-in-time system health snapshots, recorded each admin page load, to show a trend
    // instead of only the current live check.
    match /adminHealthHistory/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Help Center articles — authored only by the site admin. The public Help Center page
    // queries with a published == true filter, so this "resource.data.published == true"
    // clause is what actually restricts that query's results; isAdmin() lets the admin panel
    // see drafts too.
    match /helpArticles/{articleId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
