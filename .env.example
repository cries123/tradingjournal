# Production site (custom domain)
SITE_URL=https://trendchasers.net

# SnapTrade (broker connect — Schwab & Robinhood sync)
# Sign up at https://dashboard.snaptrade.com to get these.
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=

# Firebase Admin (server-side — required for broker connect, since it needs
# somewhere secure to store each user's SnapTrade user secret)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase (optional cloud sync)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Set to false to remove the "Continue with Google" button entirely — email sign-in is
# unaffected. Use this if Google sign-in is misconfigured and you want the button gone
# immediately rather than waiting to fix the console settings.
#
# Google sign-in needs BOTH of these in the Firebase console, or every attempt fails:
#   1. Authentication → Sign-in method → Google → Enabled
#   2. Authentication → Settings → Authorized domains → your live domain listed
#      (trendchasers.net AND www.trendchasers.net if you serve both)
# Missing either one produces auth/operation-not-allowed or auth/unauthorized-domain.
# VITE_GOOGLE_SIGNIN_ENABLED=true

# ── Payments (Creem) ────────────────────────────────────────────────────────
# Dashboard: https://www.creem.io — create one product per paid plan, then paste
# each product's id below. The ids are what the webhook uses to tell which plan
# was bought, so a wrong id silently grants the wrong tier.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_SILVER=
# CREEM_PRODUCT_GOLD=
# CREEM_PRODUCT_DIAMOND=
#
# Set to true ONLY while testing against Creem's sandbox. It switches the API
# host to test-api.creem.io, which needs its own key and its own product ids.
# CREEM_TEST_MODE=false
#
# Where buyers are returned after paying. Falls back to the request origin, then
# to https://trendchasers.net.
# PUBLIC_SITE_URL=https://trendchasers.net
